---
import SendEmailFfm from '@components/edi/SendEmailFfm.jsx';
import SendEmailFhl from '@components/edi/SendEmailFhl.jsx';
import SendEmailFwb from '@components/edi/SendEmailFwb.jsx';
import AdminLayout from '@layouts/BaseLayout.astro';

const { slug = '' } = Astro.params;
const [tipe = '', mawb = ''] = (slug || '').split('@');
---

<AdminLayout
  title="EDI | AIRLINE FLIGHT MANIFEST (FFM) MESSAGE"
  ,
  description="AIRLINE FLIGHT MANIFEST (FFM) MESSAGE"
>
  <div class="row">
    <div class="col-12">
      {tipe === 'fhl' ? <SendEmailFhl client:load slug={mawb} /> : ''}
      {tipe === 'fwb' ? <SendEmailFwb client:load slug={mawb} /> : ''}
      {tipe === 'ffm' ? <SendEmailFfm client:load slug={mawb} /> : ''}
    </div>
  </div>
</AdminLayout>
