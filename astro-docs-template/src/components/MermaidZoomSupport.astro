<div id="mermaid-zoom-overlay" class="mermaid-zoom-overlay" aria-hidden="true"></div>

<style is:global>
  .mermaid.zoomable {
    cursor: zoom-in;
    border-radius: 0.75rem;
    padding: 1.5rem;
    background-color: var(--theme-bg-offset, #f1f5f9);
    border: 1px solid var(--theme-divider, rgba(148, 163, 184, 0.3));
    margin: 1.5rem 0;
    transition: box-shadow 200ms ease, transform 200ms ease;
    overflow: hidden;
  }

  .mermaid.zoomable:hover {
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.12);
  }

  .mermaid.zoomable.is-zoomed {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    max-width: min(90vw, 1100px);
    max-height: 90vh;
    width: 90vw;
    z-index: 1001;
    background-color: var(--theme-bg, #fff);
    box-shadow: 0 25px 60px rgba(15, 23, 42, 0.35);
    cursor: zoom-out;
    overflow: auto;
  }

  .mermaid.zoomable svg {
    width: 100%;
    height: auto;
  }

  .mermaid-zoom-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease;
    z-index: 1000;
  }

  .mermaid-zoom-overlay.active {
    opacity: 1;
    pointer-events: all;
  }
</style>

<script is:inline>
  ;(() => {
    const overlay = document.getElementById('mermaid-zoom-overlay')
    if (!overlay) return
    let zoomedDiagram = null

    const handleKeydown = (event) => {
      if (event.key === 'Escape') {
        closeZoom()
      }
    }

    const closeZoom = () => {
      if (zoomedDiagram) {
        zoomedDiagram.classList.remove('is-zoomed')
        zoomedDiagram = null
      }
      overlay.classList.remove('active')
      overlay.setAttribute('aria-hidden', 'true')
      window.removeEventListener('keydown', handleKeydown)
    }

    const enhanceDiagrams = () => {
      document.querySelectorAll('.mermaid.zoomable').forEach((diagram) => {
        if (diagram.dataset.zoomableAttached) return
        diagram.dataset.zoomableAttached = 'true'
        diagram.addEventListener('click', (event) => {
          event.stopPropagation()
          if (zoomedDiagram === diagram) {
            closeZoom()
            return
          }
          if (zoomedDiagram) {
            zoomedDiagram.classList.remove('is-zoomed')
          }
          zoomedDiagram = diagram
          diagram.classList.add('is-zoomed')
          overlay.classList.add('active')
          overlay.setAttribute('aria-hidden', 'false')
          window.addEventListener('keydown', handleKeydown)
        })
      })
    }

    overlay.addEventListener('click', closeZoom)

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', enhanceDiagrams, { once: true })
    } else {
      enhanceDiagrams()
    }

    document.addEventListener('astro:after-swap', enhanceDiagrams)
  })()
</script>
