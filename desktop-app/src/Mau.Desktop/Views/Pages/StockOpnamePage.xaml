<Page x:Class="Mau.Desktop.Views.Pages.StockOpnamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            
            <TextBlock FontSize="28"
                       FontWeight="SemiBold"
                       Text="Stock Opname - Input Scan Rack" />

            <TextBlock Margin="0,8,0,14"
                       Foreground="#666"
                       Text="Input HAWB dan mapping rack untuk proses stock opname." />

            <ui:Card Padding="18">
                <StackPanel>
                    
                    
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Margin="0,0,0,6"
                                   Foreground="#666"
                                   Text="Rack" />
                        <TextBlock Grid.Row="0"
                                   Grid.Column="2"
                                   Margin="0,0,0,6"
                                   Foreground="#666"
                                   Text="HAWB" />

                        <ComboBox Grid.Row="1"
                                  Grid.Column="0"
                                  Height="34"
                                  VerticalContentAlignment="Center"
                                  Padding="8,0"
                                  FontSize="17"
                                  ItemsSource="{Binding ViewModel.RackOptions}"
                                  SelectedItem="{Binding ViewModel.SelectedRack, Mode=TwoWay}"
                                  SelectionChanged="ComboBox_SelectionChanged" />

                        <TextBox Grid.Row="1"
                                 Grid.Column="2"
                                 Height="34"
                                 VerticalContentAlignment="Center"
                                 Padding="10,0"
                                 FontSize="22"
                                 FontWeight="SemiBold"
                                 Text="{Binding ViewModel.HawbNumber, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        

                        <DataGrid Grid.Column="2"
                                  Height="245"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True"
                                  GridLinesVisibility="All"
                                  ItemsSource="{Binding ViewModel.InputScanRows}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Rack}"
                                                    Header="Rack"
                                                    Width="130" />
                                <DataGridTextColumn Binding="{Binding Hawb}"
                                                    Header="HAWB"
                                                    Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                        <ui:Button Margin="0,0,10,0"
                                   Appearance="Danger"
                                   Icon="{ui:SymbolIcon DismissCircle24}"
                                   Content="Clear"
                                   Click="OnClearInputScanClick" />
                        <ui:Button Appearance="Primary"
                                   Icon="{ui:SymbolIcon CheckmarkCircle24}"
                                   Content="Simpan"
                                   Click="OnSaveInputScanClick" />
                    </StackPanel>

                    <TextBlock Margin="0,10,0,0"
                               Foreground="#666"
                               Text="{Binding ViewModel.StatusMessage}" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>

