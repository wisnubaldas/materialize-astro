{
  "compilerOptions": {
    "baseUrl": ".",
    "checkJs": false,
    "paths": {
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@js/*": ["src/js/*"],
      "@scss/*": ["src/scss/*"],
      "@vendor/*": ["src/vendor/*"],
      "@lib/*": ["src/lib/*"],
      "@libs/*": ["src/libs/*"]
    }
  },
  "include": ["src/**/*", "astro.config.mjs"],
  "exclude": ["dist", "node_modules"]
}
