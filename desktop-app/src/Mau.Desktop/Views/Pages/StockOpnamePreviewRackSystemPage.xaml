<Page x:Class="Mau.Desktop.Views.Pages.StockOpnamePreviewRackSystemPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="RackCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="76" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF1BC8E5" Offset="0" />
                        <GradientStop Color="#FF1D78E9" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock FontSize="28"
                       FontWeight="SemiBold"
                       Text="Stock Opname - Preview Rack System" />

            <TextBlock Margin="0,8,0,14"
                       Foreground="#666"
                       Text="Cari berdasarkan HAWB lalu lihat rack yang terpetakan di sistem." />

            <ui:Card Padding="18">
                <StackPanel>
                    <TextBlock Margin="4,0,0,6"
                               Foreground="#5E5E5E"
                               Text="Search by HAWB" />

                    <Border Background="#FFD0EAF0"
                            CornerRadius="6"
                            Padding="10,6">
                        <TextBox Height="34"
                                 VerticalContentAlignment="Center"
                                 Padding="8,0"
                                 FontSize="16"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Text="{Binding ViewModel.PreviewSearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>

                    <ItemsControl Margin="0,14,0,0"
                                  ItemsSource="{Binding ViewModel.PreviewRackCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RackCardStyle}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="31"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               Text="{Binding}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>

