# External API base URL. Do not include a trailing slash.
VITE_API_BASE_URL=https://your-api-domain.com/api

# Use mock login during early development.
# true  = login works with the dummy account in README.md
# false = login calls the external API URL above
VITE_USE_MOCK_AUTH=true

# Login endpoint path on the external API.
VITE_AUTH_LOGIN_PATH=/auth/login

# Application display name.
VITE_APP_NAME=Simple Mobile App
