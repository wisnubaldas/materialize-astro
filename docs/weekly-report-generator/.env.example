GEMINI_API_KEY=
GEMINI_AUTO_MODEL_FALLBACK=true
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash
GEMINI_MODEL_RETRY_DELAY=5

# Outlook / Microsoft 365 SMTP
# Default resmi Microsoft 365 umumnya smtp.office365.com:587 STARTTLS.
# Jika akun mas perlu host lain, ubah SMTP_HOST sesuai konfigurasi mailbox.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=manager@example.com;supervisor@example.com
SMTP_CC=it@example.com;ops@example.com
SMTP_BCC=
