<Page x:Class="Mau.Desktop.Views.Pages.ScanXrayCheckInPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <ui:Card Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="30"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Text="MAWB" />

                        <TextBox Margin="0,10,0,0"
                                 Height="54"
                                 FontSize="28"
                                 FontWeight="SemiBold"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding ViewModel.Mawb, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource TertiaryTextBrush}"
                                   Text="Nomor Airwaybill dari scan barcode atau input manual." />
                    </StackPanel>

                    <ui:Button Grid.Column="2"
                               Height="54"
                               MinWidth="110"
                               VerticalAlignment="Bottom"
                               Appearance="Primary"
                               Content="Lookup"
                               Command="{Binding ViewModel.LookupNowCommand}" />
                </Grid>
            </ui:Card>

            <ItemsControl Margin="0,18,0,0"
                          ItemsSource="{Binding ViewModel.XrayImageCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="8"
                                 Padding="0">
                            <Grid Height="410">
                                <Border Background="#FFF0F0F0"
                                        BorderBrush="#FFCBCBCB"
                                        BorderThickness="1">
                                    <Image Source="{Binding ImagePath}"
                                           Stretch="UniformToFill">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasImage}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Border>

                                <TextBlock FontSize="42"
                                           Foreground="#705A5A5A"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="X-Ray Image">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasImage}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Border VerticalAlignment="Bottom"
                                        Background="#9A111827"
                                        Padding="10,8">
                                    <TextBlock Foreground="White"
                                               FontWeight="SemiBold"
                                               Text="{Binding Title}" />
                                </Border>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ui:Card Margin="0,18,0,0"
                     Padding="24">
                <StackPanel>
                    <TextBlock FontSize="26"
                               FontWeight="SemiBold"
                               Text="Response data endpoint TPS Online" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Text="no_bl_awb" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ViewModel.NoBlAwb}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" FontWeight="SemiBold" Text="tgl_bl_awb" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,8,0,0" Text="{Binding ViewModel.TglBlAwb}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" FontWeight="SemiBold" Text="ref_num" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,8,0,0" Text="{Binding ViewModel.RefNum}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,0,0" FontWeight="SemiBold" Text="nm_angkut" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,8,0,0" Text="{Binding ViewModel.NmAngkut}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,8,0,0" FontWeight="SemiBold" Text="no_voy_flight" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Margin="0,8,0,0" Text="{Binding ViewModel.NoVoyFlight}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,8,0,0" FontWeight="SemiBold" Text="uraian_brg" />
                        <TextBlock Grid.Row="5" Grid.Column="2" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding ViewModel.UraianBrg}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,18,0,0"
                     Padding="14"
                     Background="#40F3B8B8">
                <StackPanel>
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="{Binding ViewModel.StatusMessage}" />

                    <ProgressBar Margin="0,10,0,0"
                                 Height="24"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ViewModel.ProgressValue}"
                                 IsIndeterminate="{Binding ViewModel.IsProgressIndeterminate}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Foreground" Value="{DynamicResource ProgressNormalBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.IsProgressError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ProgressErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource ErrorTextBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding ViewModel.HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Text="{Binding ViewModel.ErrorMessage}" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
