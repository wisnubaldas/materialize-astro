{
  "name": "ionic-js-mobile-agent-starter",
  "version": "1.0.0",
  "private": true,
  "description": "JavaScript-only Ionic React + Capacitor mobile starter with agent rules, login page, dashboard page, and production build guide.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "cap:init": "npx cap init SimpleMobileApp com.example.simplemobileapp --web-dir=dist",
    "cap:add:android": "npx cap add android",
    "cap:sync:android": "npx cap sync android",
    "cap:open:android": "npx cap open android",
    "android:live": "ionic cap run android -l --external"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/network": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@ionic/react": "^8.0.0",
    "@ionic/react-router": "^8.0.0",
    "ionicons": "^7.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^5.3.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.4.2"
  }
}
