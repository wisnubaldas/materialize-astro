{
  "cli": {
    "version": ">= 13.0.0"
  },
  "build": {
    "preview": {
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.mitraadira.com",
        "EXPO_PUBLIC_USE_MOCK_AUTH": "false"
      }
    },
    "production": {
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.mitraadira.com",
        "EXPO_PUBLIC_USE_MOCK_AUTH": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
