---
import Menu from '@components/Menu.jsx';
import { filterMenuByName, getMenuData } from '@components/MenuData.js';
import Nav from '@components/Nav.jsx';
import { ToasterProvider } from '@components/ToasterProvider.jsx';
import VendorLoader from '@components/VendorLoader.jsx';
import { AUTH_COOKIE_NAME } from '@lib/auth/config';
import { ensureAuthenticated } from '@lib/auth/server-guard';
import '@scss/core.scss';
import favicon from '@vendor/favicon.ico?url';
interface Props {
  title: string;
  description: string;
  currentPathOverride?: string;
}
const {
  title = 'MAU APP',
  description = 'Frontend SSR project powered by Astro and React.',
  currentPathOverride,
} = Astro.props;

ensureAuthenticated(Astro);

const user = Astro.locals as any;
const username = user.user?.username ?? '';
const token = Astro.cookies.get(AUTH_COOKIE_NAME)?.value;
// RBAC: menu tree dipilih oleh backend berdasarkan role user dari token.
const menuSource = await getMenuData({ token });
let menuData = menuSource;

if (user.user?.username === 'hubnet@mitraadira.com') {
  const filtered = filterMenuByName(menuSource, 'hub');
  menuData = filtered.length > 0 ? filtered : menuSource;
}

const currentPath = currentPathOverride || Astro.url?.pathname || '/';
---

<!doctype html>
<html
  lang="en"
  class="layout-navbar-static layout-menu-fixed layout-compact"
  dir="ltr"
  data-skin="default"
  data-bs-theme="light"
  data-assets-path="/assets/"
  data-template="vertical-menu-template-starter"
>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0"
    />
    <meta name="robots" content="noindex, nofollow" />
    <title>
      {title}
    </title>

    <meta name="description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href={favicon} />

    <!-- Fonts -->
    <!-- <link rel="stylesheet" href="/assets/css/core.css" /> -->
  </head>
  <body>
    <div class="layout-wrapper layout-content-navbar">
      <div class="layout-container">
        <Menu menuData={menuData} currentPath={currentPath} />
        <VendorLoader client:load />

        <div class="menu-mobile-toggler d-xl-none rounded-1">
          <a
            href="#"
            class="layout-menu-toggle menu-link text-large text-bg-secondary p-2 rounded-1"
            onclick="event.preventDefault();"
          >
            <i class="ri ri-menu-line icon-base"></i>
            <i class="ri ri-arrow-right-s-line icon-base"></i>
          </a>
        </div>

        <div class="layout-page">
          <Nav client:load username={username} menuData={menuData} currentPath={currentPath} />
          <div style="min-height: 600px;">
            <slot />
          </div>
          <footer class="content-footer footer bg-footer-theme bg-dark text-white">
            <div class="container-xxl">
              <div
                class="footer-container d-flex align-items-center justify-content-between py-4 flex-md-row flex-column"
              >
                <div class="mb-2 mb-md-0">
                  &#169; 2025, made with ❤️ by
                  <a href="#" class="footer-link fw-medium" onclick="event.preventDefault();">
                    Wisnu Baldas
                  </a>
                </div>
                <div class="d-none d-lg-inline-block">
                  <a
                    href="https://demos.pixinvent.com/materialize-html-admin-template/documentation/"
                    target="_blank"
                    class="footer-link me-4"
                  >
                    Documentation
                  </a>
                </div>
              </div>
            </div>
          </footer>
          <div class="content-backdrop fade"></div>
        </div>
      </div>
      <!-- Overlay -->
      <div class="layout-overlay layout-menu-toggle"></div>

      <!-- Drag Target Area To SlideIn Menu On Small Screens -->
      <div class="drag-target"></div>
    </div>
    <ToasterProvider client:load />
  </body>
</html>
