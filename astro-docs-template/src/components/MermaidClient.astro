<script type="module" is:inline>
  const loadMermaid = async () => {
    if (!window.__mermaidPromise) {
      window.__mermaidPromise = import('https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs').then(
        (mod) => mod.default ?? mod
      );
    }

    const mermaid = await window.__mermaidPromise;

    if (!window.__mermaidInitialized) {
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'loose',
        theme: 'neutral'
      });
      window.__mermaidInitialized = true;
    }

    await mermaid.run({ nodes: document.querySelectorAll('.mermaid') });
  };

  const renderMermaid = () => {
    loadMermaid().catch((error) => {
      console.error('Mermaid failed to render', error);
    });
  };

  const attachListeners = () => {
    if (!window.__mermaidListenersAttached) {
      document.addEventListener('astro:after-swap', renderMermaid);
      window.__mermaidListenersAttached = true;
    }
  };

  if (document.readyState !== 'loading') {
    renderMermaid();
  } else {
    document.addEventListener('DOMContentLoaded', renderMermaid, { once: true });
  }

  attachListeners();
</script>
