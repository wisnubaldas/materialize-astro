---
import LoginCard from '@components/auth/LoginCard.jsx';
import VendorLoader from '@components/VendorLoader';
import '@js/_template-customizer/_template-customizer.scss';
import '@libs/@form-validation/form-validation.scss';
import '@libs/node-waves/node-waves.scss';
import '@libs/perfect-scrollbar/perfect-scrollbar.scss';
import '@libs/pickr/pickr-themes.scss';
import '@scss/core.scss';
import '@vendor/css/demo.css';
import '@vendor/css/pages/page-auth.css';
---

<!doctype html>
<html
  lang="en"
  class="layout-wide customizer-hide"
  dir="ltr"
  data-skin="default"
  data-bs-theme="light"
  data-assets-path="/"
  data-template="vertical-menu-template"
>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0"
    />
    <meta name="robots" content="noindex, nofollow" />
    <title>Login</title>
    <meta name="description" content="" />
  </head>

  <body>
    <!-- Content -->
    <div class="position-relative">
      <div class="authentication-wrapper authentication-basic container-p-y p-4 p-sm-0">
        <div class="authentication-inner py-6">
          <!-- Login -->
          <LoginCard />
          <!-- /Login -->
          <img
            alt="mask"
            src="/assets/img/illustrations/auth-basic-login-mask-light.png"
            class="authentication-image d-none d-lg-block"
            data-app-light-img="/assets/img/illustrations/auth-basic-login-mask-light.png"
            data-app-dark-img="/assets/img/illustrations/auth-basic-login-mask-dark.png"
          />
        </div>
      </div>
    </div>
    <VendorLoader client:only="react" loadLoginScripts />
  </body>
</html>
