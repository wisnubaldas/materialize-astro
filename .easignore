# EAS CLI archives from the Git root in this monorepo, even when the
# build command is run from mobile-app. Keep the upload scoped to Expo.

# Repository metadata and sibling projects not needed by the mobile build
/.git
/.git/
/.git/**
.git/
**/.git/
**/.git/**
.agent/
.vscode/
astro/
desktop-app/
docker-asset/
docs/
email-template/
materialize-fastapi/
.gitlab-ci.yml
AGENTS.md
deploy-development.sh
deploy-production.sh
README.md

# Mobile dependencies, caches, and generated output
mobile-app/node_modules/
mobile-app/.expo/
mobile-app/.eas-inspect-archive/
mobile-app/dist/
mobile-app/web-build/
mobile-app/build/

# Native build artifacts only; keep tracked native source in mobile-app/android
mobile-app/android/.gradle/
mobile-app/android/.cxx/
mobile-app/android/build/
mobile-app/android/app/build/
mobile-app/android/app/.cxx/
mobile-app/ios/build/

# Local environment files. Configure production values through EAS secrets/env.
mobile-app/.env
mobile-app/.env.local
mobile-app/.env.production
mobile-app/.env.*.local

# Signing keys and credentials
mobile-app/*.jks
mobile-app/*.keystore
mobile-app/*.p8
mobile-app/*.p12
mobile-app/*.mobileprovision

# Logs and OS/editor noise
mobile-app/*.log
mobile-app/npm-debug.log*
mobile-app/yarn-debug.log*
mobile-app/yarn-error.log*
mobile-app/.expo-server*.log
mobile-app/.DS_Store
mobile-app/Thumbs.db

# Test and coverage artifacts
mobile-app/coverage/
mobile-app/.nyc_output/
