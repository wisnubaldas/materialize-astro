---
import { encryptKey } from "@assets/js/crypto.js";
import LogViewer from "@components/Back/LogViewer.astro";
import Layout from "@layouts/Layout.astro";
const user = "wisnu"; // misalnya diambil dari session login
const encryptedKey = encodeURIComponent(await encryptKey({ user }));
const streamUrl = "http://localhost:8000/sse/log-send-invoice-ap2?key=" + encryptedKey;
---

<Layout title='Status Response Invoice Terkirim'>
  <div class='row'>
    <LogViewer title='Status Invoice Terkirim' height='400px' streamUrl={streamUrl} />
  </div>
</Layout>
